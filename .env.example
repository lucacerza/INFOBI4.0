# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
# Chiavi dedicate (consigliate in produzione). Se vuote usano SECRET_KEY come fallback.
# IMPORTANTE: non cambiare DATA_ENCRYPTION_KEY dopo aver cifrato password di connessione,
# altrimenti diventano indecifrabili.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
# 'production' fa rifiutare l'avvio se le chiavi sono ai valori di default
ENVIRONMENT=development

# Database (internal)
DATABASE_URL=sqlite+aiosqlite:///./data/infobi.db

# Cache (Dragonfly/Redis)
REDIS_URL=redis://cache:6379

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Backup automatico DB (SQLite)
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Logging
LOG_LEVEL=INFO
